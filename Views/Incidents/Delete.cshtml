@model SchoolSafetySystem.Models.Incident
@{ ViewData["Title"] = "Delete Incident"; }

<h4 class="fw-bold mb-4 text-danger">Delete Incident</h4>
<div class="card border-0 shadow-sm" style="max-width:500px">
    <div class="card-body">
        <p>Are you sure you want to delete <strong>@Model.Title</strong>?</p>
        <p class="text-muted small">Location: @Model.Location?.Building | Date: @Model.IncidentDate.ToString("dd MMM yyyy")</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
