@model SchoolSafetySystem.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<h4 class="mb-4 fw-bold"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h4>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-1 fw-bold text-primary">@Model.TotalIncidents</div>
            <div class="text-muted">Total Incidents</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-1 fw-bold text-warning">@Model.PendingCount</div>
            <div class="text-muted">Pending</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-1 fw-bold text-info">@Model.UnderInvestigationCount</div>
            <div class="text-muted">Under Investigation</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fs-1 fw-bold text-success">@Model.ResolvedCount</div>
            <div class="text-muted">Resolved</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Recent Incidents</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Title</th><th>Location</th><th>Date</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model.RecentIncidents)
                        {
                            <tr>
                                <td><a asp-controller="Incidents" asp-action="Details" asp-route-id="@i.Id">@i.Title</a></td>
                                <td>@i.Location?.Building</td>
                                <td>@i.IncidentDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (i.Status == SchoolSafetySystem.Models.IncidentStatus.Pending)
                                    { <span class="badge badge-pending">Pending</span> }
                                    else if (i.Status == SchoolSafetySystem.Models.IncidentStatus.UnderInvestigation)
                                    { <span class="badge bg-info">Under Investigation</span> }
                                    else
                                    { <span class="badge bg-success">Resolved</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Incidents by Category</div>
            <div class="card-body">
                @foreach (var kv in Model.ByCategory)
                {
                    <div class="mb-2">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>@kv.Key</span><span>@kv.Value</span>
                        </div>
                        <div class="progress" style="height:8px">
                            <div class="progress-bar bg-primary" style="width:@(Model.TotalIncidents > 0 ? (kv.Value * 100 / Model.TotalIncidents) : 0)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
