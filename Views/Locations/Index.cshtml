@model IEnumerable<SchoolSafetySystem.Models.Location>
@{ ViewData["Title"] = "Locations"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-geo-alt me-2"></i>Locations</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Location</a>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Building</th><th>Room</th><th></th></tr></thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td>@l.Building</td>
                        <td>@l.Room</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@l.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@l.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this location?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
